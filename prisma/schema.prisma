// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Lane {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
}

model Champion {
  id        String   @id // Data Dragon champion id, e.g. "Ahri"
  key       Int      @unique // Data Dragon numeric key, e.g. 103
  nameEn    String
  nameJa    String
  titleJa   String
  tags      String // JSON-encoded string[] of Data Dragon tags
  iconUrl   String
  updatedAt DateTime @updatedAt

  memosAsMine     MatchupMemo[] @relation("MyChampionMemos")
  memosAsOpponent MatchupMemo[] @relation("OpponentChampionMemos")
}

model MatchupMemo {
  id                 String   @id @default(cuid())
  userId             String
  lane               Lane
  myChampionId       String
  opponentChampionId String
  memo               String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  myChampion       Champion @relation("MyChampionMemos", fields: [myChampionId], references: [id])
  opponentChampion Champion @relation("OpponentChampionMemos", fields: [opponentChampionId], references: [id])

  @@unique([userId, myChampionId, opponentChampionId, lane])
  @@index([userId, myChampionId])
}

// --- Auth.js (NextAuth v5) ---
// Standard schema required by @auth/prisma-adapter:
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  memos         MatchupMemo[]
  searchHistory SummonerSearchHistory[]
}

model SummonerSearchHistory {
  id         String   @id @default(cuid())
  userId     String
  platform   String
  gameName   String
  tagLine    String
  searchedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, gameName, tagLine])
  @@index([userId, searchedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
