# Neonダッシュボード(https://console.neon.tech)の "Connection Details" から取得。
# DATABASE_URL: pooled connection(アプリの通常のクエリ用、末尾に "-pooler" が付くホスト名)
# DIRECT_URL:   direct connection(マイグレーション用、pooler経由しない接続)
# ローカル開発と本番(Vercel)で同じNeonプロジェクトを使う場合は同じ値でOK。
DATABASE_URL=""
DIRECT_URL=""

# https://developer.riotgames.com/ でRiot Sign-Onログイン後に発行されるAPIキー。
RIOT_API_KEY=""

# --- ログイン(Auth.js) ---
# セッション暗号化用のランダムな秘密鍵。`openssl rand -base64 33` などで生成。
AUTH_SECRET=""

# Google Cloud Console(https://console.cloud.google.com/apis/credentials)で作成したOAuthクライアント。
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Discord Developer Portal(https://discord.com/developers/applications)で作成したOAuthアプリ。
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
